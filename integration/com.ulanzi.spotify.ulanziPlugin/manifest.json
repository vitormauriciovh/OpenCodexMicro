{
  "Author": "OpenCodexMicro",
  "Name": "Spotify Music Picker",
  "Overview": "Spotify Music Picker and Player controller for Ulanzi D200 Series in Ulanzi Studio.",
  "Description": "Turn your Ulanzi D200 Series into a full Spotify Music Picker and controller on macOS.\n\nFEATURES\n- Wide Screen Now Playing HUD with high-res cover art, track info, and playback progress.\n- Row 1 & 2 Music Picker buttons showing Made for You, Daily Mixes, and Most Played playlists.\n- Play/Pause, Next, Previous, Shuffle, Repeat, and Like transport controls.\n- Rotary volume and playlist scroll dials.\n- Native macOS zero-latency local control combined with Spotify Web API catalog.",
  "Icon": "assets/icons/plugin.png",
  "Category": "Music",
  "CategoryIcon": "assets/icons/plugin.png",
  "Banner": [
    "assets/banners/codex-micro-banner-1.png",
    "assets/banners/codex-micro-banner-2.png",
    "assets/banners/codex-micro-banner-3.png"
  ],
  "Version": "0.4.1",
  "UUID": "com.ulanzi.ulanzistudio.spotify",
  "Type": "JavaScript",
  "CodePath": "dist/app.js",
  "Software": {
    "MinVersion": "3.0.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13.0"
    }
  ],
  "Actions": [
    {
      "Name": "Spotify Now Playing (Wide HUD)",
      "Icon": "assets/icons/task-working.png",
      "PropertyInspectorPath": "property-inspector/setup.html",
      "UUID": "com.ulanzi.ulanzistudio.spotify.nowplaying",
      "Tooltip": "Display current playing track, artist, album art and progress on wide screen.",
      "Controllers": ["Keypad"],
      "DisableAutomaticStates": true,
      "States": [{ "Name": "Now Playing", "Image": "assets/icons/task-working.png" }]
    },
    {
      "Name": "Spotify Play / Pause",
      "Icon": "assets/icons/submit.png",
